binds {
    Alt+Print hotkey-overlay-title="Screenshot: Window" { spawn "dms" "screenshot" "window"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Power Menu: Open" { spawn "dms" "ipc" "call" "powermenu" "open"; }
    Ctrl+Print hotkey-overlay-title="Screenshot: Full Screen" { spawn "dms" "screenshot" "full"; }
    Mod+R hotkey-overlay-title="Default Launcher: Toggle" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Print hotkey-overlay-title="Screenshot: Region" { spawn "dms" "screenshot"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume Down (5%)" { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Microphone Mute Toggle" { spawn "dms" "ipc" "call" "mic" "mute"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Volume Mute Toggle" { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Media: Next Track" { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Media: Play/Pause" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Media: Previous Track" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume Up (5%)" { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioStop allow-when-locked=true hotkey-overlay-title="Media: Stop" { spawn "dms" "ipc" "call" "mpris" "stop"; }
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness Down (5%)" { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Brightness Up (5%)" { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    Mod+Shift+K hotkey-overlay-title="Move Window To Workspace Up" { move-window-to-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Move Window To Workspace Down" { move-window-to-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="Focus Workspace Down" { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="Focus Workspace Up" { focus-workspace-up; }
    Mod+Ctrl+H hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Ctrl+J hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Ctrl+K hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Ctrl+L hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }
    Mod+D hotkey-overlay-title="Cycle Column Width" { switch-preset-column-width; }
    Mod+Equal hotkey-overlay-title="Set Column Width (+10%)" { set-column-width "+10%"; }
    Mod+F hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+H hotkey-overlay-title="Focus Left" { focus-column-left; }
    Mod+L hotkey-overlay-title="Focus Right" { focus-column-right; }
    Mod+M hotkey-overlay-title="Maximize Window To Edges" { maximize-window-to-edges; }
    Mod+Minus hotkey-overlay-title="Set Colum Width (-10%)" { set-column-width "-10%"; }
    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+Shift+Ctrl+H hotkey-overlay-title="Move Column To Monitor Left" { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J hotkey-overlay-title="Move Column To Monitor Down" { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K hotkey-overlay-title="Move Column To Monitor Up" { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L hotkey-overlay-title="Move Column To Monitor Right" { move-column-to-monitor-right; }
    Mod+Shift+D hotkey-overlay-title="Cycle Column Width Back" { switch-preset-column-width-back; }
    Mod+Shift+Equal hotkey-overlay-title="Set Window Height (+10%)" { set-window-height "+10%"; }
    Mod+Shift+F hotkey-overlay-title="Toggle Fullscreen" { fullscreen-window; }
    Mod+Shift+H hotkey-overlay-title="Move Left" { move-column-left; }
    Mod+Shift+L hotkey-overlay-title="Move Right" { move-column-right; }
    Mod+Shift+Minus hotkey-overlay-title="Set Window Height (-10%)" { set-window-height "-10%"; }
    Mod+Shift+V hotkey-overlay-title="Switch Floating/Tiling Focus" { switch-focus-between-floating-and-tiling; }
    Mod+V hotkey-overlay-title="Toggle Floating Window" { toggle-window-floating; }
    Mod+Shift+P hotkey-overlay-title="Power Off Monitors" { power-off-monitors; }
    Mod+Shift+E hotkey-overlay-title="Quit Niri" { quit; }
    Mod+B allow-when-locked=true hotkey-overlay-title="Launch Web Browser: firefox" { spawn "firefox"; }
    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Shortcuts Inhibit" { toggle-keyboard-shortcuts-inhibit; }
    Mod+O repeat=false hotkey-overlay-title="Toggle Overview" { toggle-overview; }
    Mod+Shift+Slash hotkey-overlay-title="Show Hot Key Overlay" { show-hotkey-overlay; }
}
