environment {
  _JAVA_AWT_WM_NONREPARENTING "1"
  QT_QPA_PLATFORM "wayland"
}

spawn-at-startup "waybar"
spawn-at-startup "swayidle"
spawn-sh-at-startup "swaybg -i ~/Pictures/Wallpapers/evening-sky.png"

hotkey-overlay {
  skip-at-startup
}

prefer-no-csd

window-rule {
  match app-id=r#"firefox$"# title="^Picture-in-Picture$"
  open-floating true
}

window-rule {
  geometry-corner-radius 16
  clip-to-geometry true
}

overview {
  zoom 1
  backdrop-color "#181825"
}

include "includes/cursor.kdl"
include "includes/binds.kdl"
include "includes/input.kdl"
include "includes/layout.kdl"
